<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ja</string>
	<key>CFBundleDisplayName</key>
	<string>しりとり</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- 標準的なHTTPS通信のみで独自暗号は使っていない（輸出規制の対象外）。
	     これにより TestFlight/App Store 提出時の輸出コンプライアンス質問が省略される。 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- 近くの端末との対戦（MultipeerConnectivity）に必要。
	     iOS 14 以降はこの2つが無いと相手を見つけられない。
	     NSBonjourServices は NearbySession.serviceType と一致させること。 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>「近くの人と対戦する」で、同じ部屋にあるもう1台のiPhone・iPadを見つけてつなぐために使います。たとえば、相手の端末が作った部屋を一覧に表示し、単語をやり取りします。この機能を使わないときは通信しません。</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_shiritori-game._tcp</string>
		<string>_shiritori-game._udp</string>
	</array>

	<!-- AdMob のアプリID。これが無いと SDK が例外を投げてアプリが落ちる。
	     本番のアプリID（アプリIDは全ビルド共通でよい。広告ユニットIDの側を
	     AdConfig が #if DEBUG でテスト用に切り替える）。 -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-5308803840858138~8729737916</string>

	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
